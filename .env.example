# Database
# Local development:
# DATABASE_URL="mysql://user:password@localhost:3306/techconnect"
#
# Production/Vercel must use an online MySQL database, never localhost.
DATABASE_URL="mysql://user:password@public-mysql-host:3306/techconnect"

# JWT Secret - Generate a secure random string
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
JWT_EXPIRES_IN="7d"

# Server
SERVER_PORT=3001
NODE_ENV="development"

# Frontend URL (for CORS)
FRONTEND_URL="http://localhost:4321"

# API URL (for frontend to connect to backend)
# In Vercel production use PUBLIC_API_URL="/api"
PUBLIC_API_URL="http://localhost:3001/api"
PUBLIC_SOCKET_URL="http://localhost:3001"
