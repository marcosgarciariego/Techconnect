---
import Layout from './Layout.astro';
import { HeaderWithAuth } from '../components/layout/HeaderWithAuth';
import { SidebarWithAuth } from '../components/layout/SidebarWithAuth';

interface Props {
  title: string;
}

const { title } = Astro.props;
const currentPath = Astro.url.pathname;
---

<Layout title={title}>
  <div class="min-h-screen bg-gray-50" id="dashboard-root">
    <HeaderWithAuth client:only="react" currentPath={currentPath} />
    <div class="flex min-h-0">
      <SidebarWithAuth client:only="react" currentPath={currentPath} />
      <main class="min-w-0 flex-1 p-8">
        <slot />
      </main>
    </div>
  </div>
</Layout>

<script>
  import { authApi } from '../lib/api';

  const checkAuth = async () => {
    try {
      const data = await authApi.validate();
      if (!data.success || !data.data?.valid) {
        window.location.href = '/login?redirect=' + encodeURIComponent(window.location.pathname);
      }
    } catch (error) {
      window.location.href = '/login?redirect=' + encodeURIComponent(window.location.pathname);
    }
  };

  checkAuth();
</script>
