---
import Layout from './Layout.astro';

interface Props {
  title: string;
}

const { title } = Astro.props;
const currentPath = Astro.url.pathname;

const adminLinks = [
  { href: '/admin', label: 'Dashboard', icon: 'M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6' },
  { href: '/admin/usuarios', label: 'Usuarios', icon: 'M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z' },
  { href: '/admin/anuncios', label: 'Anuncios', icon: 'M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2' },
  { href: '/admin/categorias', label: 'Categorías', icon: 'M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z' },
  { href: '/admin/auditoria', label: 'Auditoría', icon: 'M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z' },
];
---

<Layout title={title}>
  <div class="min-h-screen bg-gray-50">
    <header class="sticky top-0 z-40 border-b border-gray-200 bg-white">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="flex h-16 items-center justify-between">
          <a href="/" class="flex items-center space-x-2">
            <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-primary-600">
              <span class="text-lg font-bold text-white">T</span>
            </div>
            <span class="text-xl font-bold text-gray-900">TechConnect</span>
            <span class="ml-2 rounded bg-red-100 px-2 py-0.5 text-xs font-medium text-red-800">Admin</span>
          </a>

          <nav class="hidden items-center gap-1 md:flex">
            {adminLinks.map((link) => (
              <a
                href={link.href}
                class={`rounded-lg px-3 py-2 text-sm font-medium transition-colors ${
                  currentPath === link.href
                    ? 'bg-primary-50 text-primary-700'
                    : 'text-gray-600 hover:bg-gray-100 hover:text-gray-900'
                }`}
              >
                {link.label}
              </a>
            ))}
          </nav>

          <div id="admin-user-menu" class="relative flex items-center">
            <button
              id="admin-user-menu-button"
              type="button"
              class="flex items-center gap-2 rounded-full px-1.5 py-1 text-gray-500 transition-colors hover:bg-gray-100 hover:text-gray-700 focus:outline-none focus:ring-2 focus:ring-primary-500 focus:ring-offset-2"
              aria-haspopup="menu"
              aria-expanded="false"
            >
              <img
                id="admin-avatar-image"
                class="hidden h-9 w-9 rounded-full object-cover ring-1 ring-gray-200"
                alt="Administrador"
              />
              <span
                id="admin-avatar-initials"
                class="flex h-9 w-9 items-center justify-center rounded-full bg-primary-100 text-sm font-semibold text-primary-700 ring-1 ring-primary-200"
              >
                A
              </span>
              <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </button>

            <div
              id="admin-user-menu-dropdown"
              class="absolute right-0 top-full z-50 mt-2 hidden w-64 rounded-lg border border-gray-200 bg-white py-2 shadow-lg"
              role="menu"
            >
              <div class="border-b border-gray-100 px-4 py-3">
                <p id="admin-user-name" class="truncate text-sm font-semibold text-gray-900">Administrador</p>
                <p id="admin-user-email" class="truncate text-xs text-gray-500"></p>
              </div>
              <div class="py-1 md:hidden">
                {adminLinks.map((link) => (
                  <a href={link.href} class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-50" role="menuitem">
                    {link.label}
                  </a>
                ))}
              </div>
              <div class="border-t border-gray-100 py-1 md:border-t-0">
                <a href="/dashboard/perfil" class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-50" role="menuitem">
                  Mi perfil
                </a>
                <button
                  id="admin-logout-button"
                  type="button"
                  class="block w-full px-4 py-2 text-left text-sm text-red-600 hover:bg-gray-50"
                  role="menuitem"
                >
                  Cerrar sesion
                </button>
              </div>
            </div>
          </div>
        </div>
      </div>
    </header>

    <div class="flex">
      <aside class="hidden min-h-screen w-64 shrink-0 border-r border-gray-200 bg-white md:block">
        <nav class="space-y-1 p-4">
          {adminLinks.map((link) => (
            <a
              href={link.href}
              class={`flex items-center rounded-lg px-4 py-2.5 text-sm font-medium transition-colors ${
                currentPath === link.href
                  ? 'bg-primary-50 text-primary-700'
                  : 'text-gray-700 hover:bg-gray-100'
              }`}
            >
              <svg class="mr-3 h-5 w-5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={link.icon} />
              </svg>
              {link.label}
            </a>
          ))}
        </nav>
      </aside>

      <main class="flex-1 p-8">
        <slot />
      </main>
    </div>
  </div>
</Layout>

<script>
  import { authApi } from '../lib/api';

  const menu = document.getElementById('admin-user-menu');
  const menuButton = document.getElementById('admin-user-menu-button');
  const menuDropdown = document.getElementById('admin-user-menu-dropdown');
  const avatarImage = document.getElementById('admin-avatar-image') as HTMLImageElement | null;
  const avatarInitials = document.getElementById('admin-avatar-initials');
  const adminUserName = document.getElementById('admin-user-name');
  const adminUserEmail = document.getElementById('admin-user-email');
  const logoutButton = document.getElementById('admin-logout-button');

  const getInitials = (name: string) => {
    const parts = name.trim().split(/\s+/).filter(Boolean);
    const initials = parts.slice(0, 2).map((part) => part[0]).join('');
    return initials.toUpperCase() || 'A';
  };

  const setMenuOpen = (isOpen: boolean) => {
    menuDropdown?.classList.toggle('hidden', !isOpen);
    menuButton?.setAttribute('aria-expanded', String(isOpen));
  };

  menuButton?.addEventListener('click', () => {
    const isOpen = menuButton.getAttribute('aria-expanded') === 'true';
    setMenuOpen(!isOpen);
  });

  document.addEventListener('click', (event) => {
    if (menu && !menu.contains(event.target as Node)) {
      setMenuOpen(false);
    }
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') {
      setMenuOpen(false);
    }
  });

  logoutButton?.addEventListener('click', async () => {
    await authApi.logout();
    window.location.href = '/';
  });

  const renderAdminUser = (user: any) => {
    const fullName = user.fullName || 'Administrador';
    adminUserName!.textContent = fullName;
    adminUserEmail!.textContent = user.email || '';
    avatarInitials!.textContent = getInitials(fullName);

    if (user.avatarUrl && avatarImage) {
      avatarImage.src = user.avatarUrl;
      avatarImage.alt = fullName;
      avatarImage.classList.remove('hidden');
      avatarInitials?.classList.add('hidden');
    }
  };

  const checkAdminAuth = async () => {
    try {
      const data = await authApi.validate();
      if (!data.success || !data.data?.valid) {
        window.location.href = '/login';
        return;
      }

      if (!data.data.user.roles.includes('admin')) {
        window.location.href = '/dashboard';
        return;
      }

      renderAdminUser(data.data.user);
    } catch (error) {
      window.location.href = '/login';
    }
  };

  checkAdminAuth();
</script>
