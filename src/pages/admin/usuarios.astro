---
import AdminLayout from '../../layouts/AdminLayout.astro';
---

<AdminLayout title="Gestión de Usuarios">
  <div id="users-management-content"></div>
</AdminLayout>

<script>
  import { adminApi } from '../../lib/api';
  import { formatDate } from '../../lib/utils';

  const container = document.getElementById('users-management-content');
  let currentPage = 1;
  const pageSize = 15;
  let searchQuery = '';
  let roleFilter = '';

  async function loadUsers() {
    try {
      const params = new URLSearchParams();
      params.set('page', currentPage.toString());
      params.set('pageSize', pageSize.toString());
      if (searchQuery) params.set('search', searchQuery);
      if (roleFilter) params.set('role', roleFilter);

      const response = await adminApi.listUsers(params);
      if (!response.success) throw new Error('Error');

      const { items: users, total, totalPages } = response.data;

      container!.innerHTML = `
        <div class="mb-8">
          <h1 class="text-2xl font-bold text-gray-900">Gestión de Usuarios</h1>
          <p class="mt-1 text-gray-600">${total} usuarios registrados</p>
        </div>

        <!-- Filters -->
        <div class="bg-white rounded-xl border border-gray-200 p-4 mb-6">
          <div class="flex flex-col sm:flex-row gap-4">
            <div class="flex-1">
              <input
                type="text"
                id="search-input"
                value="${searchQuery}"
                placeholder="Buscar por nombre o email..."
                class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-transparent"
              />
            </div>
            <select id="role-filter" class="px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-transparent">
              <option value="">Todos los roles</option>
              <option value="client" ${roleFilter === 'client' ? 'selected' : ''}>Cliente</option>
              <option value="professional" ${roleFilter === 'professional' ? 'selected' : ''}>Profesional</option>
              <option value="admin" ${roleFilter === 'admin' ? 'selected' : ''}>Administrador</option>
            </select>
          </div>
        </div>

        <!-- Users table -->
        <div class="bg-white rounded-xl border border-gray-200 overflow-hidden">
          <div class="overflow-x-auto">
            <table class="w-full">
              <thead class="bg-gray-50 border-b border-gray-200">
                <tr>
                  <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Usuario</th>
                  <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Roles</th>
                  <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Ciudad</th>
                  <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Registro</th>
                  <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Estado</th>
                  <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Acciones</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-gray-200">
                ${users.length === 0 ? `
                  <tr>
                    <td colspan="6" class="px-6 py-12 text-center text-gray-500">
                      No se encontraron usuarios
                    </td>
                  </tr>
                ` : users.map((user: any) => `
                  <tr class="hover:bg-gray-50">
                    <td class="px-6 py-4 whitespace-nowrap">
                      <div class="flex items-center">
                        <div class="h-10 w-10 rounded-full bg-primary-100 flex items-center justify-center text-primary-700 font-medium">
                          ${user.fullName?.split(' ').map((n: string) => n[0]).join('').slice(0, 2) || '??'}
                        </div>
                        <div class="ml-4">
                          <div class="text-sm font-medium text-gray-900">${user.fullName}</div>
                          <div class="text-sm text-gray-500">${user.email}</div>
                        </div>
                      </div>
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap">
                      <div class="flex flex-wrap gap-1">
                        ${user.roles?.map((r: any) => {
                          const roleName = typeof r === 'string' ? r : r?.role?.name;
                          const colors: Record<string, string> = {
                            client: 'bg-blue-100 text-blue-700',
                            professional: 'bg-green-100 text-green-700',
                            admin: 'bg-red-100 text-red-700',
                          };
                          return `<span class="px-2 py-0.5 text-xs font-medium rounded-full ${colors[roleName] || 'bg-gray-100 text-gray-700'}">${roleName || 'Sin rol'}</span>`;
                        }).join('')}
                      </div>
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                      ${user.city || '-'}
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                      ${formatDate(user.createdAt)}
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap">
                      <span class="px-2 py-1 text-xs font-medium rounded-full ${user.isActive ? 'bg-green-100 text-green-700' : 'bg-red-100 text-red-700'}">
                        ${user.isActive ? 'Activo' : 'Inactivo'}
                      </span>
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap text-right text-sm">
                      <div class="flex items-center justify-end gap-2">
                        <button class="toggle-status p-1 text-gray-400 hover:text-primary-600" data-id="${user.id}" data-active="${user.isActive}" title="${user.isActive ? 'Desactivar' : 'Activar'}">
                          ${user.isActive ? `
                            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636" />
                            </svg>
                          ` : `
                            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                            </svg>
                          `}
                        </button>
                        <button class="manage-roles p-1 text-gray-400 hover:text-primary-600" data-id="${user.id}" data-name="${user.fullName}" data-roles="${user.roles?.map((r: any) => typeof r === 'string' ? r : r?.role?.name).filter(Boolean).join(',')}" title="Gestionar roles">
                          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                          </svg>
                        </button>
                      </div>
                    </td>
                  </tr>
                `).join('')}
              </tbody>
            </table>
          </div>
        </div>

        ${totalPages > 1 ? `
          <div class="mt-6 flex justify-center gap-2">
            <button id="prev-page" class="px-4 py-2 border border-gray-300 rounded-lg hover:bg-gray-50 disabled:opacity-50 disabled:cursor-not-allowed" ${currentPage === 1 ? 'disabled' : ''}>
              Anterior
            </button>
            <span class="px-4 py-2 text-gray-600">
              Página ${currentPage} de ${totalPages}
            </span>
            <button id="next-page" class="px-4 py-2 border border-gray-300 rounded-lg hover:bg-gray-50 disabled:opacity-50 disabled:cursor-not-allowed" ${currentPage === totalPages ? 'disabled' : ''}>
              Siguiente
            </button>
          </div>
        ` : ''}
      `;

      // Event handlers
      let searchTimeout: any;
      document.getElementById('search-input')?.addEventListener('input', (e) => {
        clearTimeout(searchTimeout);
        searchTimeout = setTimeout(() => {
          searchQuery = (e.target as HTMLInputElement).value;
          currentPage = 1;
          loadUsers();
        }, 500);
      });

      document.getElementById('role-filter')?.addEventListener('change', (e) => {
        roleFilter = (e.target as HTMLSelectElement).value;
        currentPage = 1;
        loadUsers();
      });

      document.getElementById('prev-page')?.addEventListener('click', () => {
        if (currentPage > 1) {
          currentPage--;
          loadUsers();
        }
      });

      document.getElementById('next-page')?.addEventListener('click', () => {
        currentPage++;
        loadUsers();
      });

      // Toggle user status
      document.querySelectorAll('.toggle-status').forEach((btn) => {
        btn.addEventListener('click', async () => {
          const id = (btn as HTMLElement).dataset.id;
          const isActive = (btn as HTMLElement).dataset.active === 'true';
          const action = isActive ? 'desactivar' : 'activar';

          if (id && confirm(`¿${action.charAt(0).toUpperCase() + action.slice(1)} este usuario?`)) {
            try {
              await adminApi.toggleUserActive(id, !isActive);
              loadUsers();
            } catch (error) {
              alert('Error al actualizar el estado del usuario');
            }
          }
        });
      });

      // Manage roles
      document.querySelectorAll('.manage-roles').forEach((btn) => {
        btn.addEventListener('click', () => {
          const id = (btn as HTMLElement).dataset.id;
          const name = (btn as HTMLElement).dataset.name;
          const roles = (btn as HTMLElement).dataset.roles?.split(',').filter(Boolean) || [];
          showRolesModal(id!, name!, roles);
        });
      });
    } catch (error) {
      container!.innerHTML = `
        <div class="text-center py-12">
          <p class="text-gray-600">Error al cargar los usuarios</p>
          <button onclick="location.reload()" class="mt-4 text-primary-600 hover:text-primary-700">
            Reintentar
          </button>
        </div>
      `;
    }
  }

  function showRolesModal(userId: string, userName: string, currentRoles: string[]) {
    const modal = document.createElement('div');
    modal.className = 'fixed inset-0 z-50 flex items-center justify-center bg-black/50';
    modal.innerHTML = `
      <div class="bg-white rounded-xl p-6 w-full max-w-md mx-4">
        <h3 class="text-lg font-semibold text-gray-900 mb-2">Gestionar roles</h3>
        <p class="text-sm text-gray-500 mb-4">Usuario: ${userName}</p>

        <div class="space-y-3">
          ${['client', 'professional', 'admin'].map((role) => {
            const labels: Record<string, string> = {
              client: 'Cliente',
              professional: 'Profesional',
              admin: 'Administrador',
            };
            const checked = currentRoles.includes(role);
            return `
              <label class="flex items-center gap-3 p-3 border border-gray-200 rounded-lg cursor-pointer hover:bg-gray-50">
                <input type="checkbox" class="role-checkbox h-4 w-4 text-primary-600 rounded border-gray-300 focus:ring-primary-500" data-role="${role}" ${checked ? 'checked' : ''}>
                <span class="text-sm font-medium text-gray-700">${labels[role]}</span>
              </label>
            `;
          }).join('')}
        </div>

        <div class="mt-6 flex gap-3">
          <button id="close-modal" class="flex-1 px-4 py-2 border border-gray-300 rounded-lg hover:bg-gray-50">
            Cerrar
          </button>
        </div>
      </div>
    `;

    document.body.appendChild(modal);

    // Role checkbox handlers
    modal.querySelectorAll('.role-checkbox').forEach((checkbox) => {
      checkbox.addEventListener('change', async (e) => {
        const role = (checkbox as HTMLInputElement).dataset.role;
        const isChecked = (checkbox as HTMLInputElement).checked;

        try {
          if (isChecked) {
            await adminApi.addRole(userId, role!);
          } else {
            await adminApi.removeRole(userId, role!);
          }
        } catch (error) {
          alert('Error al actualizar el rol');
          (checkbox as HTMLInputElement).checked = !isChecked;
        }
      });
    });

    modal.querySelector('#close-modal')?.addEventListener('click', () => {
      modal.remove();
      loadUsers();
    });

    modal.addEventListener('click', (e) => {
      if (e.target === modal) {
        modal.remove();
        loadUsers();
      }
    });
  }

  loadUsers();
</script>
