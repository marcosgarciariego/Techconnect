---
import AdminLayout from '../../layouts/AdminLayout.astro';
---

<AdminLayout title="Registro de Auditoría">
  <div id="audit-logs-content"></div>
</AdminLayout>

<script>
  import { adminApi } from '../../lib/api';
  import { formatDate, formatRelativeTime } from '../../lib/utils';

  const container = document.getElementById('audit-logs-content');
  let currentPage = 1;
  const pageSize = 20;
  let actionFilter = '';
  let entityFilter = '';

  async function loadAuditLogs() {
    try {
      const params = new URLSearchParams();
      params.set('page', currentPage.toString());
      params.set('pageSize', pageSize.toString());
      if (actionFilter) params.set('action', actionFilter);
      if (entityFilter) params.set('entityType', entityFilter);

      const response = await adminApi.getAuditLogs(params);
      if (!response.success) throw new Error('Error');

      const { items: logs, total, totalPages } = response.data;

      const actionColors: Record<string, string> = {
        create: 'bg-green-100 text-green-700',
        update: 'bg-blue-100 text-blue-700',
        delete: 'bg-red-100 text-red-700',
        login: 'bg-purple-100 text-purple-700',
        logout: 'bg-gray-100 text-gray-700',
      };

      const actionLabels: Record<string, string> = {
        create: 'Crear',
        update: 'Actualizar',
        delete: 'Eliminar',
        login: 'Iniciar sesión',
        logout: 'Cerrar sesión',
      };

      const entityLabels: Record<string, string> = {
        user: 'Usuario',
        ad: 'Anuncio',
        application: 'Candidatura',
        order: 'Orden',
        category: 'Categoría',
        review: 'Valoración',
        conversation: 'Conversación',
        message: 'Mensaje',
      };

      container!.innerHTML = `
        <div class="mb-8">
          <h1 class="text-2xl font-bold text-gray-900">Registro de Auditoría</h1>
          <p class="mt-1 text-gray-600">${total} registros en total</p>
        </div>

        <!-- Filters -->
        <div class="bg-white rounded-xl border border-gray-200 p-4 mb-6">
          <div class="flex flex-col sm:flex-row gap-4">
            <select id="action-filter" class="px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-transparent">
              <option value="">Todas las acciones</option>
              <option value="create" ${actionFilter === 'create' ? 'selected' : ''}>Crear</option>
              <option value="update" ${actionFilter === 'update' ? 'selected' : ''}>Actualizar</option>
              <option value="delete" ${actionFilter === 'delete' ? 'selected' : ''}>Eliminar</option>
              <option value="login" ${actionFilter === 'login' ? 'selected' : ''}>Iniciar sesión</option>
              <option value="logout" ${actionFilter === 'logout' ? 'selected' : ''}>Cerrar sesión</option>
            </select>
            <select id="entity-filter" class="px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-transparent">
              <option value="">Todas las entidades</option>
              <option value="user" ${entityFilter === 'user' ? 'selected' : ''}>Usuario</option>
              <option value="ad" ${entityFilter === 'ad' ? 'selected' : ''}>Anuncio</option>
              <option value="application" ${entityFilter === 'application' ? 'selected' : ''}>Candidatura</option>
              <option value="order" ${entityFilter === 'order' ? 'selected' : ''}>Orden</option>
              <option value="category" ${entityFilter === 'category' ? 'selected' : ''}>Categoría</option>
              <option value="review" ${entityFilter === 'review' ? 'selected' : ''}>Valoración</option>
            </select>
          </div>
        </div>

        <!-- Audit logs table -->
        <div class="bg-white rounded-xl border border-gray-200 overflow-hidden">
          <div class="overflow-x-auto">
            <table class="w-full">
              <thead class="bg-gray-50 border-b border-gray-200">
                <tr>
                  <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Fecha/Hora</th>
                  <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Usuario</th>
                  <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Acción</th>
                  <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Entidad</th>
                  <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Detalles</th>
                  <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">IP</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-gray-200">
                ${logs.length === 0 ? `
                  <tr>
                    <td colspan="6" class="px-6 py-12 text-center text-gray-500">
                      No se encontraron registros de auditoría
                    </td>
                  </tr>
                ` : logs.map((log: any) => `
                  <tr class="hover:bg-gray-50">
                    <td class="px-6 py-4 whitespace-nowrap">
                      <div class="text-sm text-gray-900">${formatDate(log.createdAt)}</div>
                      <div class="text-xs text-gray-500">${formatRelativeTime(log.createdAt)}</div>
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap">
                      <div class="text-sm text-gray-900">${log.user?.fullName || 'Sistema'}</div>
                      <div class="text-xs text-gray-500">${log.user?.email || '-'}</div>
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap">
                      <span class="px-2 py-1 text-xs font-medium rounded-full ${actionColors[log.action] || 'bg-gray-100 text-gray-700'}">
                        ${actionLabels[log.action] || log.action}
                      </span>
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap">
                      <div class="text-sm text-gray-900">${entityLabels[log.entityType] || log.entityType}</div>
                      <div class="text-xs text-gray-500">ID: ${log.entityId || '-'}</div>
                    </td>
                    <td class="px-6 py-4">
                      <div class="max-w-xs">
                        ${log.details ? `
                          <button class="view-details text-xs text-primary-600 hover:text-primary-700" data-details='${JSON.stringify(log.details)}'>
                            Ver detalles
                          </button>
                        ` : `
                          <span class="text-xs text-gray-400">Sin detalles</span>
                        `}
                      </div>
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                      ${log.ipAddress || '-'}
                    </td>
                  </tr>
                `).join('')}
              </tbody>
            </table>
          </div>
        </div>

        ${totalPages > 1 ? `
          <div class="mt-6 flex justify-center gap-2">
            <button id="prev-page" class="px-4 py-2 border border-gray-300 rounded-lg hover:bg-gray-50 disabled:opacity-50 disabled:cursor-not-allowed" ${currentPage === 1 ? 'disabled' : ''}>
              Anterior
            </button>
            <span class="px-4 py-2 text-gray-600">
              Página ${currentPage} de ${totalPages}
            </span>
            <button id="next-page" class="px-4 py-2 border border-gray-300 rounded-lg hover:bg-gray-50 disabled:opacity-50 disabled:cursor-not-allowed" ${currentPage === totalPages ? 'disabled' : ''}>
              Siguiente
            </button>
          </div>
        ` : ''}
      `;

      // Event handlers
      document.getElementById('action-filter')?.addEventListener('change', (e) => {
        actionFilter = (e.target as HTMLSelectElement).value;
        currentPage = 1;
        loadAuditLogs();
      });

      document.getElementById('entity-filter')?.addEventListener('change', (e) => {
        entityFilter = (e.target as HTMLSelectElement).value;
        currentPage = 1;
        loadAuditLogs();
      });

      document.getElementById('prev-page')?.addEventListener('click', () => {
        if (currentPage > 1) {
          currentPage--;
          loadAuditLogs();
        }
      });

      document.getElementById('next-page')?.addEventListener('click', () => {
        currentPage++;
        loadAuditLogs();
      });

      // View details modal
      document.querySelectorAll('.view-details').forEach((btn) => {
        btn.addEventListener('click', () => {
          const details = JSON.parse((btn as HTMLElement).dataset.details || '{}');
          showDetailsModal(details);
        });
      });
    } catch (error) {
      container!.innerHTML = `
        <div class="text-center py-12">
          <p class="text-gray-600">Error al cargar los registros de auditoría</p>
          <button onclick="location.reload()" class="mt-4 text-primary-600 hover:text-primary-700">
            Reintentar
          </button>
        </div>
      `;
    }
  }

  function showDetailsModal(details: any) {
    const modal = document.createElement('div');
    modal.className = 'fixed inset-0 z-50 flex items-center justify-center bg-black/50';
    modal.innerHTML = `
      <div class="bg-white rounded-xl p-6 w-full max-w-lg mx-4 max-h-[80vh] overflow-y-auto">
        <h3 class="text-lg font-semibold text-gray-900 mb-4">Detalles de la acción</h3>
        <pre class="bg-gray-100 p-4 rounded-lg text-sm text-gray-800 overflow-x-auto">${JSON.stringify(details, null, 2)}</pre>
        <button id="close-modal" class="mt-4 w-full px-4 py-2 border border-gray-300 rounded-lg hover:bg-gray-50">
          Cerrar
        </button>
      </div>
    `;

    document.body.appendChild(modal);

    modal.querySelector('#close-modal')?.addEventListener('click', () => {
      modal.remove();
    });

    modal.addEventListener('click', (e) => {
      if (e.target === modal) {
        modal.remove();
      }
    });
  }

  loadAuditLogs();
</script>
