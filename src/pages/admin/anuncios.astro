---
import AdminLayout from '../../layouts/AdminLayout.astro';
---

<AdminLayout title="Gestión de Anuncios">
  <div id="ads-management-content"></div>
</AdminLayout>

<script>
  import { adminApi } from '../../lib/api';
  import { formatDate, formatCurrency } from '../../lib/utils';

  const container = document.getElementById('ads-management-content');
  let currentPage = 1;
  const pageSize = 15;
  let searchQuery = '';
  let statusFilter = '';

  async function loadAds() {
    try {
      const params = new URLSearchParams();
      params.set('page', currentPage.toString());
      params.set('pageSize', pageSize.toString());
      if (searchQuery) params.set('search', searchQuery);
      if (statusFilter) params.set('status', statusFilter);

      const response = await adminApi.listAds(params);
      if (!response.success) throw new Error('Error');

      const { items: ads, total, totalPages } = response.data;

      const statusColors: Record<string, string> = {
        draft: 'bg-gray-100 text-gray-700',
        active: 'bg-green-100 text-green-700',
        closed: 'bg-blue-100 text-blue-700',
        cancelled: 'bg-red-100 text-red-700',
      };

      const statusLabels: Record<string, string> = {
        draft: 'Borrador',
        active: 'Activo',
        closed: 'Cerrado',
        cancelled: 'Cancelado',
      };

      container!.innerHTML = `
        <div class="mb-8">
          <h1 class="text-2xl font-bold text-gray-900">Gestión de Anuncios</h1>
          <p class="mt-1 text-gray-600">${total} anuncios en total</p>
        </div>

        <!-- Filters -->
        <div class="bg-white rounded-xl border border-gray-200 p-4 mb-6">
          <div class="flex flex-col sm:flex-row gap-4">
            <div class="flex-1">
              <input
                type="text"
                id="search-input"
                value="${searchQuery}"
                placeholder="Buscar por título..."
                class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-transparent"
              />
            </div>
            <select id="status-filter" class="px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-transparent">
              <option value="">Todos los estados</option>
              <option value="draft" ${statusFilter === 'draft' ? 'selected' : ''}>Borrador</option>
              <option value="active" ${statusFilter === 'active' ? 'selected' : ''}>Activo</option>
              <option value="closed" ${statusFilter === 'closed' ? 'selected' : ''}>Cerrado</option>
              <option value="cancelled" ${statusFilter === 'cancelled' ? 'selected' : ''}>Cancelado</option>
            </select>
          </div>
        </div>

        <!-- Ads table -->
        <div class="bg-white rounded-xl border border-gray-200 overflow-hidden">
          <div class="overflow-x-auto">
            <table class="w-full">
              <thead class="bg-gray-50 border-b border-gray-200">
                <tr>
                  <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Anuncio</th>
                  <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Autor</th>
                  <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Categoría</th>
                  <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Presupuesto</th>
                  <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Fecha</th>
                  <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Estado</th>
                  <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Acciones</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-gray-200">
                ${ads.length === 0 ? `
                  <tr>
                    <td colspan="7" class="px-6 py-12 text-center text-gray-500">
                      No se encontraron anuncios
                    </td>
                  </tr>
                ` : ads.map((ad: any) => `
                  <tr class="hover:bg-gray-50">
                    <td class="px-6 py-4">
                      <div class="max-w-xs">
                        <a href="/anuncios/${ad.id}" target="_blank" class="text-sm font-medium text-gray-900 hover:text-primary-600 line-clamp-1">
                          ${ad.title}
                        </a>
                        <p class="text-xs text-gray-500 line-clamp-1">${ad.description}</p>
                      </div>
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap">
                      <div class="text-sm text-gray-900">${ad.user?.fullName || '-'}</div>
                      <div class="text-xs text-gray-500">${ad.user?.email || ''}</div>
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                      ${ad.category?.name || '-'}
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                      ${formatCurrency(ad.budgetMin)} - ${formatCurrency(ad.budgetMax)}
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                      ${formatDate(ad.createdAt)}
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap">
                      <span class="px-2 py-1 text-xs font-medium rounded-full ${statusColors[ad.status]}">
                        ${statusLabels[ad.status]}
                      </span>
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap text-right text-sm">
                      <div class="flex items-center justify-end gap-2">
                        <select class="change-status text-xs border border-gray-300 rounded px-2 py-1" data-id="${ad.id}">
                          <option value="">Cambiar estado</option>
                          <option value="active">Activar</option>
                          <option value="closed">Cerrar</option>
                          <option value="cancelled">Cancelar</option>
                        </select>
                        <button class="delete-ad p-1 text-gray-400 hover:text-red-600" data-id="${ad.id}" title="Eliminar">
                          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                          </svg>
                        </button>
                      </div>
                    </td>
                  </tr>
                `).join('')}
              </tbody>
            </table>
          </div>
        </div>

        ${totalPages > 1 ? `
          <div class="mt-6 flex justify-center gap-2">
            <button id="prev-page" class="px-4 py-2 border border-gray-300 rounded-lg hover:bg-gray-50 disabled:opacity-50 disabled:cursor-not-allowed" ${currentPage === 1 ? 'disabled' : ''}>
              Anterior
            </button>
            <span class="px-4 py-2 text-gray-600">
              Página ${currentPage} de ${totalPages}
            </span>
            <button id="next-page" class="px-4 py-2 border border-gray-300 rounded-lg hover:bg-gray-50 disabled:opacity-50 disabled:cursor-not-allowed" ${currentPage === totalPages ? 'disabled' : ''}>
              Siguiente
            </button>
          </div>
        ` : ''}
      `;

      // Event handlers
      let searchTimeout: any;
      document.getElementById('search-input')?.addEventListener('input', (e) => {
        clearTimeout(searchTimeout);
        searchTimeout = setTimeout(() => {
          searchQuery = (e.target as HTMLInputElement).value;
          currentPage = 1;
          loadAds();
        }, 500);
      });

      document.getElementById('status-filter')?.addEventListener('change', (e) => {
        statusFilter = (e.target as HTMLSelectElement).value;
        currentPage = 1;
        loadAds();
      });

      document.getElementById('prev-page')?.addEventListener('click', () => {
        if (currentPage > 1) {
          currentPage--;
          loadAds();
        }
      });

      document.getElementById('next-page')?.addEventListener('click', () => {
        currentPage++;
        loadAds();
      });

      // Change status
      document.querySelectorAll('.change-status').forEach((select) => {
        select.addEventListener('change', async (e) => {
          const id = (select as HTMLSelectElement).dataset.id;
          const status = (select as HTMLSelectElement).value;

          if (id && status) {
            try {
              await adminApi.updateAdStatus(id, status);
              loadAds();
            } catch (error) {
              alert('Error al cambiar el estado');
              (select as HTMLSelectElement).value = '';
            }
          }
        });
      });

      // Delete ad
      document.querySelectorAll('.delete-ad').forEach((btn) => {
        btn.addEventListener('click', async () => {
          const id = (btn as HTMLElement).dataset.id;
          if (id && confirm('¿Estás seguro de que quieres eliminar este anuncio?')) {
            try {
              await adminApi.deleteAd(id);
              loadAds();
            } catch (error) {
              alert('Error al eliminar el anuncio');
            }
          }
        });
      });
    } catch (error) {
      container!.innerHTML = `
        <div class="text-center py-12">
          <p class="text-gray-600">Error al cargar los anuncios</p>
          <button onclick="location.reload()" class="mt-4 text-primary-600 hover:text-primary-700">
            Reintentar
          </button>
        </div>
      `;
    }
  }

  loadAds();
</script>
