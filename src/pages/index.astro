---
import Layout from '../layouts/Layout.astro';
import { HeaderWithAuth } from '../components/layout/HeaderWithAuth';
import { Footer } from '../components/layout/Footer';

const steps = [
  {
    title: 'Publica tu necesidad',
    text: 'Describe el servicio, el presupuesto y los requisitos para que los profesionales adecuados te encuentren.',
    icon: 'M12 4v16m8-8H4',
  },
  {
    title: 'Compara propuestas',
    text: 'Recibe candidaturas, revisa perfiles y habla con cada profesional antes de decidir.',
    icon: 'M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0',
  },
  {
    title: 'Trabaja con confianza',
    text: 'Centraliza conversación, candidaturas y órdenes para avanzar con claridad de principio a fin.',
    icon: 'M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z',
  },
];

const categories = [
  { name: 'Desarrollo Web', description: 'Tiendas online, webs corporativas y mantenimiento.' },
  { name: 'Apps móviles', description: 'Aplicaciones iOS, Android y soluciones multiplataforma.' },
  { name: 'Diseño UX/UI', description: 'Interfaces claras para productos digitales.' },
  { name: 'Soporte técnico', description: 'Incidencias, mantenimiento y asesoría informática.' },
  { name: 'Ciberseguridad', description: 'Auditorías, protección y buenas prácticas.' },
  { name: 'Automatización', description: 'Scripts, integraciones y procesos más eficientes.' },
];
---

<Layout title="Conecta con profesionales de tecnología">
  <HeaderWithAuth client:only="react" currentPath="/" />

  <main class="bg-white">
    <section class="relative overflow-hidden border-b border-gray-200 bg-[linear-gradient(180deg,#f8fbff_0%,#ffffff_72%)]">
      <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-primary-300 to-transparent"></div>
      <div class="container-app grid items-center gap-12 py-16 lg:grid-cols-[1.05fr_0.95fr] lg:py-20">
        <div>
          <p class="inline-flex rounded-full border border-primary-200 bg-primary-50 px-3 py-1 text-sm font-medium text-primary-700">
            Servicios tecnológicos sin ruido
          </p>
          <h1 class="mt-6 max-w-3xl text-4xl font-bold leading-tight text-gray-950 lg:text-6xl">
            Encuentra el talento tecnológico que tu proyecto necesita
          </h1>
          <p class="mt-6 max-w-2xl text-lg leading-8 text-gray-600">
            TechConnect conecta a clientes con profesionales de tecnología para publicar necesidades,
            recibir candidaturas y colaborar desde un mismo panel.
          </p>
          <div class="mt-8 flex flex-col gap-3 sm:flex-row">
            <a
              href="/register"
              class="inline-flex items-center justify-center rounded-lg bg-primary-600 px-6 py-3 text-sm font-semibold text-white shadow-sm shadow-primary-600/20 transition-colors hover:bg-primary-700"
            >
              Crear cuenta gratis
            </a>
            <a
              href="/anuncios"
              class="inline-flex items-center justify-center rounded-lg border border-gray-300 bg-white px-6 py-3 text-sm font-semibold text-gray-800 transition-colors hover:border-primary-300 hover:text-primary-700"
            >
              Explorar anuncios
            </a>
          </div>
          <dl class="mt-10 grid max-w-xl grid-cols-3 gap-4 border-t border-gray-200 pt-6">
            <div>
              <dt class="text-2xl font-bold text-gray-950">3</dt>
              <dd class="mt-1 text-sm text-gray-500">roles claros</dd>
            </div>
            <div>
              <dt class="text-2xl font-bold text-gray-950">24/7</dt>
              <dd class="mt-1 text-sm text-gray-500">mensajería</dd>
            </div>
            <div>
              <dt class="text-2xl font-bold text-gray-950">100%</dt>
              <dd class="mt-1 text-sm text-gray-500">enfocado en tech</dd>
            </div>
          </dl>
        </div>

        <div class="relative">
          <div class="rounded-lg border border-gray-200 bg-white shadow-xl shadow-primary-950/10">
            <div class="flex items-center justify-between border-b border-gray-200 px-5 py-4">
              <div>
                <p class="text-sm font-semibold text-gray-900">Panel de proyecto</p>
                <p class="text-xs text-gray-500">Tienda online con WooCommerce</p>
              </div>
              <span class="rounded-full bg-green-50 px-2.5 py-1 text-xs font-medium text-green-700">Activo</span>
            </div>
            <div class="space-y-4 p-5">
              <div class="rounded-lg border border-gray-200 p-4">
                <div class="flex items-center justify-between gap-4">
                  <div>
                    <p class="text-sm font-medium text-gray-900">Candidaturas recibidas</p>
                    <p class="mt-1 text-xs text-gray-500">Profesionales disponibles para revisar</p>
                  </div>
                  <p class="text-3xl font-bold text-primary-600">8</p>
                </div>
              </div>
              <div class="grid gap-3 sm:grid-cols-2">
                <div class="rounded-lg border border-gray-200 p-4">
                  <p class="text-xs font-medium uppercase text-gray-500">Presupuesto</p>
                  <p class="mt-2 text-lg font-semibold text-gray-900">1.500 - 3.000 €</p>
                </div>
                <div class="rounded-lg border border-gray-200 p-4">
                  <p class="text-xs font-medium uppercase text-gray-500">Modalidad</p>
                  <p class="mt-2 text-lg font-semibold text-gray-900">Online</p>
                </div>
              </div>
              <div class="rounded-lg bg-gray-50 p-4">
                <div class="flex gap-3">
                  <div class="flex h-9 w-9 items-center justify-center rounded-full bg-primary-100 text-sm font-semibold text-primary-700">
                    CM
                  </div>
                  <div class="min-w-0 flex-1">
                    <p class="text-sm font-medium text-gray-900">Carlos Martínez</p>
                    <p class="mt-1 text-sm text-gray-600">Tengo experiencia en WooCommerce y pasarelas de pago. Puedo empezar esta semana.</p>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="py-16">
      <div class="container-app">
        <div class="max-w-2xl">
          <h2 class="text-3xl font-bold text-gray-950">Cómo funciona</h2>
          <p class="mt-3 text-gray-600">Un flujo sencillo para pasar de una necesidad a una colaboración real.</p>
        </div>

        <div class="mt-10 grid gap-5 md:grid-cols-3">
          {steps.map((step, index) => (
            <article class="rounded-lg border border-gray-200 bg-white p-6 shadow-sm">
              <div class="flex h-11 w-11 items-center justify-center rounded-lg bg-primary-50 text-primary-700">
                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={step.icon} />
                </svg>
              </div>
              <p class="mt-5 text-sm font-semibold text-primary-600">Paso {index + 1}</p>
              <h3 class="mt-2 text-lg font-semibold text-gray-950">{step.title}</h3>
              <p class="mt-3 text-sm leading-6 text-gray-600">{step.text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="border-y border-gray-200 bg-gray-50 py-16">
      <div class="container-app">
        <div class="flex flex-col justify-between gap-6 md:flex-row md:items-end">
          <div class="max-w-2xl">
            <h2 class="text-3xl font-bold text-gray-950">Categorías destacadas</h2>
            <p class="mt-3 text-gray-600">Explora anuncios por área y encuentra oportunidades alineadas con tu perfil.</p>
          </div>
          <a href="/anuncios" class="text-sm font-semibold text-primary-700 hover:text-primary-800">
            Ver todos los anuncios
          </a>
        </div>

        <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {categories.map((category) => (
            <a
              href={`/anuncios?search=${encodeURIComponent(category.name)}`}
              class="group rounded-lg border border-gray-200 bg-white p-5 transition-colors hover:border-primary-300 hover:bg-primary-50/40"
            >
              <div class="flex items-start justify-between gap-4">
                <div>
                  <h3 class="font-semibold text-gray-950 group-hover:text-primary-700">{category.name}</h3>
                  <p class="mt-2 text-sm leading-6 text-gray-600">{category.description}</p>
                </div>
                <svg class="mt-1 h-5 w-5 flex-shrink-0 text-gray-400 group-hover:text-primary-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="py-16">
      <div class="container-app">
        <div class="rounded-lg bg-gray-950 px-6 py-10 text-center sm:px-10">
          <h2 class="text-3xl font-bold text-white">¿Listo para empezar?</h2>
          <p class="mx-auto mt-3 max-w-2xl text-gray-300">
            Crea tu cuenta y gestiona anuncios, candidaturas y mensajes desde un panel pensado para proyectos tecnológicos.
          </p>
          <div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row">
            <a
              href="/register"
              class="inline-flex items-center justify-center rounded-lg bg-white px-6 py-3 text-sm font-semibold text-gray-950 transition-colors hover:bg-gray-100"
            >
              Crear cuenta
            </a>
            <a
              href="/anuncios"
              class="inline-flex items-center justify-center rounded-lg border border-white/30 px-6 py-3 text-sm font-semibold text-white transition-colors hover:bg-white/10"
            >
              Ver anuncios
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer client:load />
</Layout>
