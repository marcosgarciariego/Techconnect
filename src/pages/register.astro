---
import Layout from '../layouts/Layout.astro';
import { RegisterFormWithAuth } from '../components/auth/RegisterFormWithAuth';
---

<Layout title="Crear cuenta">
  <div class="flex min-h-screen flex-col justify-center bg-gray-50 py-12 sm:px-6 lg:px-8">
    <div class="sm:mx-auto sm:w-full sm:max-w-md">
      <a href="/" class="flex items-center justify-center space-x-2">
        <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-primary-600">
          <span class="text-xl font-bold text-white">T</span>
        </div>
        <span class="text-2xl font-bold text-gray-900">TechConnect</span>
      </a>
      <h2 class="mt-6 text-center text-3xl font-bold text-gray-900">
        Crea tu cuenta
      </h2>
      <p class="mt-2 text-center text-sm text-gray-600">
        Únete a la comunidad de profesionales y clientes
      </p>
    </div>

    <div class="mt-8 sm:mx-auto sm:w-full sm:max-w-lg">
      <div class="rounded-lg border border-gray-200 bg-white px-4 py-8 shadow-sm sm:px-10">
        <RegisterFormWithAuth client:only="react" />
      </div>
    </div>
  </div>
</Layout>
