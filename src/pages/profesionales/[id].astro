---
import Layout from '../../layouts/Layout.astro';

const { id } = Astro.params;
---

<Layout title="Perfil Profesional">
  <div id="professional-profile" data-id={id}></div>
</Layout>

<script>
  import { userApi, reviewApi } from '../../lib/api';
  import { formatRelativeTime } from '../../lib/utils';

  const container = document.getElementById('professional-profile');
  const professionalId = container?.dataset.id;

  function renderStars(rating: number): string {
    return Array(5).fill(0).map((_, i) => `
      <svg class="h-5 w-5 ${i < rating ? 'text-yellow-400' : 'text-gray-300'}" fill="currentColor" viewBox="0 0 20 20">
        <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
      </svg>
    `).join('');
  }

  async function loadProfile() {
    if (!professionalId) {
      container!.innerHTML = '<p class="text-center py-12 text-red-600">ID de profesional no válido</p>';
      return;
    }

    try {
      const [profileResponse, reviewsResponse, statsResponse] = await Promise.all([
        userApi.getPublicProfile(professionalId),
        reviewApi.getUserReviews(professionalId),
        reviewApi.getUserStats(professionalId),
      ]);

      if (!profileResponse.success) throw new Error('Usuario no encontrado');

      const user = profileResponse.data;
      const reviews = reviewsResponse.success ? reviewsResponse.data.items : [];
      const stats = statsResponse.success ? statsResponse.data : { avgRating: 0, totalReviews: 0 };

      const availabilityLabels: Record<string, string> = {
        'full-time': 'Tiempo completo',
        'part-time': 'Tiempo parcial',
        freelance: 'Freelance',
        weekends: 'Fines de semana',
      };

      container!.innerHTML = `
        <div class="bg-gray-50 min-h-screen">
          <!-- Header -->
          <div class="bg-white border-b border-gray-200">
            <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
              <a href="/anuncios" class="text-sm text-primary-600 hover:text-primary-700 mb-6 inline-block">
                ← Volver a anuncios
              </a>

              <div class="flex flex-col md:flex-row md:items-start gap-6">
                <div class="h-24 w-24 rounded-full bg-primary-100 flex items-center justify-center text-primary-700 font-bold text-3xl flex-shrink-0">
                  ${user.avatarUrl ? `<img src="${user.avatarUrl}" alt="${user.fullName}" class="h-24 w-24 rounded-full object-cover" />` : user.fullName?.split(' ').map((n: string) => n[0]).join('').slice(0, 2) || '??'}
                </div>

                <div class="flex-1">
                  <div class="flex items-center gap-3 mb-2">
                    <h1 class="text-2xl font-bold text-gray-900">${user.fullName}</h1>
                    ${user.professionalProfile?.verified ? `
                      <span class="inline-flex items-center gap-1 px-2 py-0.5 text-xs font-medium text-green-700 bg-green-100 rounded-full">
                        <svg class="h-3 w-3" fill="currentColor" viewBox="0 0 20 20">
                          <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                        </svg>
                        Verificado
                      </span>
                    ` : ''}
                  </div>

                  <div class="flex flex-wrap items-center gap-4 text-sm text-gray-500 mb-4">
                    ${user.city ? `
                      <span class="flex items-center gap-1">
                        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                        </svg>
                        ${user.city}
                      </span>
                    ` : ''}
                    ${stats.totalReviews > 0 ? `
                      <span class="flex items-center gap-1">
                        <svg class="h-4 w-4 text-yellow-400" fill="currentColor" viewBox="0 0 20 20">
                          <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                        </svg>
                        ${stats.avgRating?.toFixed(1)} (${stats.totalReviews} valoraciones)
                      </span>
                    ` : ''}
                  </div>

                  ${user.bio ? `<p class="text-gray-600 mb-4">${user.bio}</p>` : ''}
                </div>
              </div>
            </div>
          </div>

          <!-- Content -->
          <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
              <!-- Main content -->
              <div class="lg:col-span-2 space-y-6">
                <!-- Professional description -->
                ${user.professionalProfile?.description ? `
                  <div class="bg-white rounded-xl border border-gray-200 p-6">
                    <h2 class="text-lg font-semibold text-gray-900 mb-4">Sobre mí</h2>
                    <p class="text-gray-600 whitespace-pre-line">${user.professionalProfile.description}</p>
                  </div>
                ` : ''}

                <!-- Reviews -->
                <div class="bg-white rounded-xl border border-gray-200 p-6">
                  <h2 class="text-lg font-semibold text-gray-900 mb-4">Valoraciones</h2>

                  ${reviews.length === 0 ? `
                    <p class="text-gray-500 text-center py-8">Este profesional aún no tiene valoraciones</p>
                  ` : `
                    <div class="space-y-6">
                      ${reviews.slice(0, 5).map((review: any) => `
                        <div class="border-b border-gray-100 last:border-0 pb-6 last:pb-0">
                          <div class="flex items-start gap-4">
                            <div class="h-10 w-10 rounded-full bg-gray-100 flex items-center justify-center text-gray-500 font-medium flex-shrink-0">
                              ${review.reviewer?.fullName?.split(' ').map((n: string) => n[0]).join('').slice(0, 2) || '??'}
                            </div>
                            <div class="flex-1">
                              <div class="flex items-center justify-between">
                                <p class="font-medium text-gray-900">${review.reviewer?.fullName || 'Usuario'}</p>
                                <span class="text-xs text-gray-400">${formatRelativeTime(review.createdAt)}</span>
                              </div>
                              <div class="flex items-center mt-1 mb-2">
                                ${renderStars(review.rating)}
                              </div>
                              ${review.comment ? `
                                <p class="text-gray-600 text-sm">${review.comment}</p>
                              ` : ''}
                            </div>
                          </div>
                        </div>
                      `).join('')}
                    </div>
                  `}
                </div>
              </div>

              <!-- Sidebar -->
              <div class="space-y-6">
                <!-- Stats card -->
                <div class="bg-white rounded-xl border border-gray-200 p-6">
                  <h3 class="text-lg font-semibold text-gray-900 mb-4">Información profesional</h3>

                  <div class="space-y-4">
                    ${user.professionalProfile?.yearsExperience ? `
                      <div class="flex justify-between">
                        <span class="text-gray-500">Experiencia</span>
                        <span class="font-medium text-gray-900">${user.professionalProfile.yearsExperience} años</span>
                      </div>
                    ` : ''}
                    ${user.professionalProfile?.hourlyRate ? `
                      <div class="flex justify-between">
                        <span class="text-gray-500">Tarifa por hora</span>
                        <span class="font-medium text-gray-900">${user.professionalProfile.hourlyRate}€/h</span>
                      </div>
                    ` : ''}
                    ${user.professionalProfile?.availability ? `
                      <div class="flex justify-between">
                        <span class="text-gray-500">Disponibilidad</span>
                        <span class="font-medium text-gray-900">${availabilityLabels[user.professionalProfile.availability] || user.professionalProfile.availability}</span>
                      </div>
                    ` : ''}
                    ${user.professionalProfile?.portfolioUrl ? `
                      <div class="pt-2 border-t border-gray-100">
                        <a href="${user.professionalProfile.portfolioUrl}" target="_blank" rel="noopener noreferrer" class="flex items-center gap-2 text-primary-600 hover:text-primary-700">
                          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                          </svg>
                          Ver portfolio
                        </a>
                      </div>
                    ` : ''}
                  </div>
                </div>

                <!-- Rating summary -->
                ${stats.totalReviews > 0 ? `
                  <div class="bg-white rounded-xl border border-gray-200 p-6">
                    <div class="text-center">
                      <p class="text-4xl font-bold text-gray-900">${stats.avgRating?.toFixed(1)}</p>
                      <div class="flex justify-center mt-2">
                        ${renderStars(Math.round(stats.avgRating || 0))}
                      </div>
                      <p class="text-sm text-gray-500 mt-1">${stats.totalReviews} valoraciones</p>
                    </div>
                  </div>
                ` : ''}

                <!-- Contact info -->
                <div class="bg-primary-50 rounded-xl border border-primary-100 p-6">
                  <h3 class="font-medium text-primary-900 mb-2">¿Te interesa trabajar conmigo?</h3>
                  <p class="text-sm text-primary-700 mb-4">Publica un anuncio y podré enviarte una candidatura.</p>
                  <a href="/dashboard/cliente/nuevo-anuncio" class="block w-full text-center px-4 py-2 bg-primary-600 text-white rounded-lg hover:bg-primary-700 transition-colors">
                    Publicar anuncio
                  </a>
                </div>
              </div>
            </div>
          </div>
        </div>
      `;
    } catch (error) {
      container!.innerHTML = `
        <div class="max-w-5xl mx-auto px-4 py-12 text-center">
          <svg class="h-16 w-16 mx-auto text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
          </svg>
          <h2 class="mt-4 text-xl font-semibold text-gray-900">Perfil no encontrado</h2>
          <p class="mt-2 text-gray-600">El profesional que buscas no existe o ya no está disponible.</p>
          <a href="/anuncios" class="mt-4 inline-block text-primary-600 hover:text-primary-700">
            Volver a anuncios
          </a>
        </div>
      `;
    }
  }

  loadProfile();
</script>
