---
import DashboardLayout from '../../../layouts/DashboardLayout.astro';
---

<DashboardLayout title="Mis Candidaturas">
  <div id="my-applications-content"></div>
</DashboardLayout>

<script>
  import { applicationApi, conversationApi, getApiUrl, orderApi } from '../../../lib/api';
  import { formatDate, formatCurrency, formatRelativeTime } from '../../../lib/utils';

  const container = document.getElementById('my-applications-content');
  let currentPage = 1;
  const pageSize = 10;
  let currentStatus = '';

  function escapeHtml(value: unknown) {
    return String(value ?? '')
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#039;');
  }

  function formatFileSize(size: number) {
    if (!size) return '';
    if (size < 1024 * 1024) return `${Math.round(size / 1024)} KB`;
    return `${(size / 1024 / 1024).toFixed(1)} MB`;
  }

  function getAttachmentUrl(url: string) {
    if (/^https?:\/\//.test(url)) return url;
    return `${getApiUrl().replace(/\/api$/, '')}${url}`;
  }

  function attachmentsHtml(attachments: any[] = []) {
    if (!attachments.length) return '';

    return `
      <div class="mt-3 rounded-lg border border-gray-200 bg-white p-3">
        <p class="mb-2 text-xs font-medium uppercase tracking-wide text-gray-500">Archivos enviados</p>
        <div class="flex flex-wrap gap-2">
          ${attachments.map((attachment) => `
            <a href="${escapeHtml(getAttachmentUrl(attachment.url))}" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 rounded-md border border-gray-200 px-3 py-2 text-sm text-gray-700 hover:border-primary-300 hover:bg-primary-50">
              <svg class="h-4 w-4 text-primary-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.172 7l-6.586 6.586a2 2 0 102.828 2.828l6.586-6.586a4 4 0 00-5.657-5.657l-6.586 6.586a6 6 0 108.486 8.486L20.5 13" />
              </svg>
              <span>${escapeHtml(attachment.originalName)}</span>
              <span class="text-xs text-gray-400">${formatFileSize(attachment.size)}</span>
            </a>
          `).join('')}
        </div>
      </div>
    `;
  }

  async function openApplicationConversation(applicationId: string) {
    try {
      const response = await conversationApi.getForApplication(applicationId);
      if (response.success && response.data) {
        window.location.href = `/dashboard/mensajes?conversationId=${response.data.id}`;
        return;
      }

      alert('No se pudo abrir la conversación de esta candidatura');
    } catch (error) {
      alert('Error al iniciar la conversación');
    }
  }

  async function loadApplications() {
    try {
      const params = new URLSearchParams();
      params.set('page', currentPage.toString());
      params.set('pageSize', pageSize.toString());
      if (currentStatus) params.set('status', currentStatus);

      const response = await applicationApi.getMine(params);
      if (!response.success) throw new Error('Error');

      const { items: applications, total, totalPages } = response.data;

      const statusColors: Record<string, string> = {
        pending: 'bg-yellow-100 text-yellow-700',
        accepted: 'bg-green-100 text-green-700',
        rejected: 'bg-red-100 text-red-700',
        cancelled: 'bg-gray-100 text-gray-700',
      };

      const statusLabels: Record<string, string> = {
        pending: 'Pendiente',
        accepted: 'Aceptada',
        rejected: 'Rechazada',
        cancelled: 'Cancelada',
      };

      container!.innerHTML = `
        <div class="mb-8">
          <h1 class="text-2xl font-bold text-gray-900">Mis Candidaturas</h1>
          <p class="mt-1 text-gray-600">${total} candidaturas enviadas</p>
        </div>

        <div class="mb-6 flex flex-col sm:flex-row gap-4">
          <select id="status-filter" class="px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-transparent">
            <option value="">Todos los estados</option>
            <option value="pending" ${currentStatus === 'pending' ? 'selected' : ''}>Pendiente</option>
            <option value="accepted" ${currentStatus === 'accepted' ? 'selected' : ''}>Aceptada</option>
            <option value="rejected" ${currentStatus === 'rejected' ? 'selected' : ''}>Rechazada</option>
            <option value="cancelled" ${currentStatus === 'cancelled' ? 'selected' : ''}>Cancelada</option>
          </select>
          <a href="/dashboard/profesional/explorar" class="px-4 py-2 bg-primary-600 text-white rounded-lg hover:bg-primary-700 transition-colors text-center">
            Explorar anuncios
          </a>
        </div>

        ${applications.length === 0 ? `
          <div class="text-center py-12 bg-white rounded-xl border border-gray-200">
            <svg class="h-12 w-12 mx-auto text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
            </svg>
            <p class="mt-4 text-gray-600">No tienes candidaturas${currentStatus ? ` con estado "${statusLabels[currentStatus]}"` : ''}</p>
            <a href="/dashboard/profesional/explorar" class="mt-4 inline-block text-primary-600 hover:text-primary-700">
              Explorar anuncios disponibles
            </a>
          </div>
        ` : `
          <div class="space-y-4">
            ${applications.map((app: any) => `
              <div class="bg-white rounded-xl border border-gray-200 overflow-hidden">
                <div class="p-6">
                  <div class="flex flex-col lg:flex-row lg:items-start gap-4">
                    <div class="flex-1">
                      <div class="flex items-center gap-2 mb-2">
                        <a href="/anuncios/${app.ad?.id}" class="text-lg font-semibold text-gray-900 hover:text-primary-600">
                          ${app.ad?.title || 'Anuncio'}
                        </a>
                        <span class="px-2 py-0.5 text-xs font-medium rounded-full ${statusColors[app.status]}">
                          ${statusLabels[app.status]}
                        </span>
                      </div>

                      <p class="text-sm text-gray-500 mb-3">
                        <span class="font-medium">${app.ad?.category?.name || 'Sin categoría'}</span>
                        · ${app.ad?.location || 'Sin ubicación'}
                      </p>

                      ${app.coverLetter ? `
                        <div class="bg-gray-50 rounded-lg p-3 mb-3">
                          <p class="text-sm text-gray-600 line-clamp-3">${app.coverLetter}</p>
                        </div>
                      ` : ''}
                      ${attachmentsHtml(app.attachments)}

                      <div class="flex flex-wrap gap-4 text-sm text-gray-500">
                        ${app.proposedPrice ? `
                          <span class="flex items-center gap-1">
                            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                            </svg>
                            Propuesto: ${formatCurrency(app.proposedPrice)}
                          </span>
                        ` : ''}
                        ${app.estimatedDays ? `
                          <span class="flex items-center gap-1">
                            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                            </svg>
                            ${app.estimatedDays} días estimados
                          </span>
                        ` : ''}
                        <span class="flex items-center gap-1">
                          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                          </svg>
                          Enviada ${formatRelativeTime(app.createdAt)}
                        </span>
                      </div>
                    </div>

                    <div class="flex flex-col gap-2">
                      <div class="text-center px-4 py-2 bg-gray-50 rounded-lg">
                        <p class="text-lg font-bold text-primary-600">${formatCurrency(app.ad?.budgetMin)} - ${formatCurrency(app.ad?.budgetMax)}</p>
                        <p class="text-xs text-gray-500">Presupuesto</p>
                      </div>

                      <button class="message-btn px-4 py-2 text-sm text-center border border-gray-300 text-gray-700 rounded-lg hover:bg-gray-50 transition-colors" data-app="${app.id}">
                        Enviar mensaje
                      </button>

                      ${app.status === 'pending' ? `
                        <button class="cancel-app px-4 py-2 text-sm text-red-600 border border-red-300 rounded-lg hover:bg-red-50 transition-colors" data-id="${app.id}">
                          Cancelar
                        </button>
                      ` : app.status === 'accepted' ? `
                        ${app.serviceOrder ? `
                          <a href="/dashboard/profesional/ordenes" class="px-4 py-2 text-sm text-center text-white bg-green-600 rounded-lg hover:bg-green-700 transition-colors">
                            Ver orden
                          </a>
                          ${app.serviceOrder.status === 'active' ? `
                            <button class="complete-order px-4 py-2 text-sm text-white bg-green-600 rounded-lg hover:bg-green-700 transition-colors" data-order="${app.serviceOrder.id}">
                              Completar trabajo
                            </button>
                          ` : ''}
                        ` : `
                          <span class="px-4 py-2 text-xs text-center text-green-700 bg-green-50 rounded-lg">
                            Pendiente de orden
                          </span>
                        `}
                      ` : ''}
                    </div>
                  </div>
                </div>

                ${app.status === 'accepted' ? `
                  <div class="px-6 py-3 bg-green-50 border-t border-green-100">
                    <p class="text-sm text-green-700">
                      ${app.serviceOrder ? '¡Enhorabuena! Tu candidatura fue aceptada. Se ha creado una orden de servicio.' : 'Tu candidatura fue aceptada. El cliente debe crear la orden de servicio para empezar.'}
                    </p>
                  </div>
                ` : app.status === 'rejected' ? `
                  <div class="px-6 py-3 bg-red-50 border-t border-red-100">
                    <p class="text-sm text-red-700">
                      Tu candidatura no fue seleccionada. No te desanimes, ¡sigue intentándolo!
                    </p>
                  </div>
                ` : ''}
              </div>
            `).join('')}
          </div>

          ${totalPages > 1 ? `
            <div class="mt-8 flex justify-center gap-2">
              <button id="prev-page" class="px-4 py-2 border border-gray-300 rounded-lg hover:bg-gray-50 disabled:opacity-50 disabled:cursor-not-allowed" ${currentPage === 1 ? 'disabled' : ''}>
                Anterior
              </button>
              <span class="px-4 py-2 text-gray-600">
                Página ${currentPage} de ${totalPages}
              </span>
              <button id="next-page" class="px-4 py-2 border border-gray-300 rounded-lg hover:bg-gray-50 disabled:opacity-50 disabled:cursor-not-allowed" ${currentPage === totalPages ? 'disabled' : ''}>
                Siguiente
              </button>
            </div>
          ` : ''}
        `}
      `;

      // Event handlers
      document.getElementById('status-filter')?.addEventListener('change', (e) => {
        currentStatus = (e.target as HTMLSelectElement).value;
        currentPage = 1;
        loadApplications();
      });

      document.getElementById('prev-page')?.addEventListener('click', () => {
        if (currentPage > 1) {
          currentPage--;
          loadApplications();
        }
      });

      document.getElementById('next-page')?.addEventListener('click', () => {
        if (currentPage < totalPages) {
          currentPage++;
          loadApplications();
        }
      });

      // Cancel application
      document.querySelectorAll('.cancel-app').forEach((btn) => {
        btn.addEventListener('click', async () => {
          const id = (btn as HTMLElement).dataset.id;
          if (id && confirm('¿Estás seguro de que quieres cancelar esta candidatura?')) {
            try {
              await applicationApi.updateStatus(id, 'cancelled');
              loadApplications();
            } catch (error) {
              alert('Error al cancelar la candidatura');
            }
          }
        });
      });

      // Message client for this application
      document.querySelectorAll('.message-btn').forEach((btn) => {
        btn.addEventListener('click', async () => {
          const applicationId = (btn as HTMLElement).dataset.app;
          if (applicationId) {
            await openApplicationConversation(applicationId);
          }
        });
      });

      // Complete accepted work
      document.querySelectorAll('.complete-order').forEach((btn) => {
        btn.addEventListener('click', async () => {
          const orderId = (btn as HTMLElement).dataset.order;
          if (orderId && confirm('¿Marcar este trabajo como completado?')) {
            try {
              await orderApi.updateStatus(orderId, 'completed');
              loadApplications();
            } catch (error) {
              alert('Error al completar el trabajo');
            }
          }
        });
      });
    } catch (error) {
      container!.innerHTML = `
        <div class="text-center py-12">
          <p class="text-gray-600">Error al cargar las candidaturas</p>
          <button onclick="location.reload()" class="mt-4 text-primary-600 hover:text-primary-700">
            Reintentar
          </button>
        </div>
      `;
    }
  }

  loadApplications();
</script>
