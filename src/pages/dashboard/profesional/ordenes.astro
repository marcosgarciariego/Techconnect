---
import DashboardLayout from '../../../layouts/DashboardLayout.astro';
---

<DashboardLayout title="Mis Órdenes de Servicio">
  <div id="professional-orders-content"></div>
</DashboardLayout>

<script>
  import { conversationApi, orderApi } from '../../../lib/api';
  import { formatDate, formatCurrency } from '../../../lib/utils';

  const container = document.getElementById('professional-orders-content');
  let currentPage = 1;
  const pageSize = 10;
  let currentStatus = '';

  async function openApplicationConversation(applicationId: string) {
    try {
      const response = await conversationApi.getForApplication(applicationId);
      if (response.success && response.data) {
        window.location.href = `/dashboard/mensajes?conversationId=${response.data.id}`;
        return;
      }

      alert('No se pudo abrir la conversación de esta orden');
    } catch (error) {
      alert('Error al abrir los mensajes');
    }
  }

  async function loadOrders() {
    try {
      const params = new URLSearchParams();
      params.set('page', currentPage.toString());
      params.set('pageSize', pageSize.toString());
      if (currentStatus) params.set('status', currentStatus);

      const response = await orderApi.getProfessionalOrders(params);
      if (!response.success) throw new Error('Error');

      const { items: orders, total, totalPages } = response.data;

      const statusColors: Record<string, string> = {
        active: 'bg-blue-100 text-blue-700',
        completed: 'bg-green-100 text-green-700',
        cancelled: 'bg-red-100 text-red-700',
      };

      const statusLabels: Record<string, string> = {
        active: 'En progreso',
        completed: 'Completada',
        cancelled: 'Cancelada',
      };

      container!.innerHTML = `
        <div class="mb-8">
          <h1 class="text-2xl font-bold text-gray-900">Mis Órdenes de Servicio</h1>
          <p class="mt-1 text-gray-600">${total} órdenes en total</p>
        </div>

        <div class="mb-6">
          <select id="status-filter" class="px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-transparent">
            <option value="">Todos los estados</option>
            <option value="active" ${currentStatus === 'active' ? 'selected' : ''}>En progreso</option>
            <option value="completed" ${currentStatus === 'completed' ? 'selected' : ''}>Completada</option>
            <option value="cancelled" ${currentStatus === 'cancelled' ? 'selected' : ''}>Cancelada</option>
          </select>
        </div>

        ${orders.length === 0 ? `
          <div class="text-center py-12 bg-white rounded-xl border border-gray-200">
            <svg class="h-12 w-12 mx-auto text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4" />
            </svg>
            <p class="mt-4 text-gray-600">No tienes órdenes de servicio${currentStatus ? ` con estado "${statusLabels[currentStatus]}"` : ''}</p>
            <a href="/dashboard/profesional/explorar" class="mt-4 inline-block text-primary-600 hover:text-primary-700">
              Explorar anuncios
            </a>
          </div>
        ` : `
          <div class="space-y-4">
            ${orders.map((order: any) => `
              <div class="bg-white rounded-xl border border-gray-200 overflow-hidden">
                <div class="p-6">
                  <div class="flex flex-col lg:flex-row lg:items-start gap-6">
                    <div class="flex-1">
                      <div class="flex items-center gap-3 mb-3">
                        <span class="text-sm text-gray-500">Orden #${order.id}</span>
                        <span class="px-2 py-0.5 text-xs font-medium rounded-full ${statusColors[order.status]}">
                          ${statusLabels[order.status]}
                        </span>
                      </div>

                      <h3 class="text-lg font-semibold text-gray-900 mb-2">
                        <a href="/anuncios/${order.application?.ad?.id}" class="hover:text-primary-600">
                          ${order.application?.ad?.title || 'Proyecto'}
                        </a>
                      </h3>

                      <div class="flex items-center gap-4 mb-4">
                        <div class="flex items-center gap-3">
                          <div class="h-10 w-10 rounded-full bg-primary-100 flex items-center justify-center text-primary-700 font-medium text-sm">
                            ${order.client?.fullName?.split(' ').map((n: string) => n[0]).join('').slice(0, 2) || '??'}
                          </div>
                          <div>
                            <p class="font-medium text-gray-900">${order.client?.fullName || 'Cliente'}</p>
                            <p class="text-sm text-gray-500">${order.client?.city || 'Sin ubicación'}</p>
                          </div>
                        </div>
                      </div>

                      <div class="flex flex-wrap gap-4 text-sm text-gray-500">
                        <span class="flex items-center gap-1">
                          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                          </svg>
                          ${formatCurrency(order.agreedPrice)}
                        </span>
                        <span class="flex items-center gap-1">
                          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                          </svg>
                          Creada: ${formatDate(order.createdAt)}
                        </span>
                        ${order.completedAt ? `
                          <span class="flex items-center gap-1 text-green-600">
                            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                            </svg>
                            Completada: ${formatDate(order.completedAt)}
                          </span>
                        ` : ''}
                      </div>
                    </div>

                    <div class="flex flex-col gap-2">
                      ${order.status === 'active' ? `
                        <button class="message-btn px-4 py-2 bg-primary-600 text-white text-sm text-center rounded-lg hover:bg-primary-700 transition-colors" data-app="${order.applicationId}">
                          Contactar cliente
                        </button>
                        <button class="complete-order px-4 py-2 border border-green-300 text-green-700 text-sm text-center rounded-lg hover:bg-green-50 transition-colors" data-id="${order.id}">
                          Marcar trabajo completado
                        </button>
                        <p class="text-xs text-gray-500 text-center">
                          También puedes cerrar el trabajo cuando esté entregado.
                        </p>
                      ` : order.status === 'completed' ? `
                        <div class="text-center px-4 py-2 bg-green-50 rounded-lg">
                          <p class="text-sm text-green-700 font-medium">Trabajo completado</p>
                        </div>
                        ${order.hasReview ? `
                          <p class="text-xs text-gray-500 text-center">Has recibido una valoración</p>
                        ` : `
                          <p class="text-xs text-gray-500 text-center">Pendiente de valoración</p>
                        `}
                      ` : ''}
                    </div>
                  </div>
                </div>

                ${order.status === 'active' ? `
                  <div class="px-6 py-3 bg-blue-50 border-t border-blue-100">
                    <p class="text-sm text-blue-700">
                      Orden en progreso. Mantente en contacto con el cliente.
                    </p>
                  </div>
                ` : ''}
              </div>
            `).join('')}
          </div>

          ${totalPages > 1 ? `
            <div class="mt-8 flex justify-center gap-2">
              <button id="prev-page" class="px-4 py-2 border border-gray-300 rounded-lg hover:bg-gray-50 disabled:opacity-50 disabled:cursor-not-allowed" ${currentPage === 1 ? 'disabled' : ''}>
                Anterior
              </button>
              <span class="px-4 py-2 text-gray-600">
                Página ${currentPage} de ${totalPages}
              </span>
              <button id="next-page" class="px-4 py-2 border border-gray-300 rounded-lg hover:bg-gray-50 disabled:opacity-50 disabled:cursor-not-allowed" ${currentPage === totalPages ? 'disabled' : ''}>
                Siguiente
              </button>
            </div>
          ` : ''}
        `}
      `;

      // Event handlers
      document.getElementById('status-filter')?.addEventListener('change', (e) => {
        currentStatus = (e.target as HTMLSelectElement).value;
        currentPage = 1;
        loadOrders();
      });

      document.getElementById('prev-page')?.addEventListener('click', () => {
        if (currentPage > 1) {
          currentPage--;
          loadOrders();
        }
      });

      document.getElementById('next-page')?.addEventListener('click', () => {
        if (currentPage < totalPages) {
          currentPage++;
          loadOrders();
        }
      });

      document.querySelectorAll('.message-btn').forEach((btn) => {
        btn.addEventListener('click', async () => {
          const applicationId = (btn as HTMLElement).dataset.app;
          if (applicationId) {
            await openApplicationConversation(applicationId);
          }
        });
      });

      document.querySelectorAll('.complete-order').forEach((btn) => {
        btn.addEventListener('click', async () => {
          const orderId = (btn as HTMLElement).dataset.id;
          if (orderId && confirm('¿Marcar este trabajo como completado?')) {
            try {
              await orderApi.updateStatus(orderId, 'completed');
              loadOrders();
            } catch (error) {
              alert('Error al completar el trabajo');
            }
          }
        });
      });
    } catch (error) {
      container!.innerHTML = `
        <div class="text-center py-12">
          <p class="text-gray-600">Error al cargar las órdenes</p>
          <button onclick="location.reload()" class="mt-4 text-primary-600 hover:text-primary-700">
            Reintentar
          </button>
        </div>
      `;
    }
  }

  loadOrders();
</script>
