---
import DashboardLayout from '../../../../layouts/DashboardLayout.astro';

const { id } = Astro.params;
---

<DashboardLayout title="Editar Anuncio">
  <div id="edit-ad-content" data-ad-id={id}></div>
</DashboardLayout>

<script>
  import { adApi, categoryApi } from '../../../../lib/api';

  const container = document.getElementById('edit-ad-content');
  const adId = container?.dataset.adId;

  async function loadAdForm() {
    if (!adId) {
      container!.innerHTML = '<p class="text-red-600">ID de anuncio no válido</p>';
      return;
    }

    try {
      const [adResponse, categoriesResponse] = await Promise.all([
        adApi.get(adId),
        categoryApi.list(),
      ]);

      if (!adResponse.success || !categoriesResponse.success) {
        throw new Error('Error al cargar datos');
      }

      const ad = adResponse.data;
      const categories = categoriesResponse.data;

      container!.innerHTML = `
        <div class="max-w-3xl">
          <div class="mb-8">
            <a href="/dashboard/cliente/anuncios" class="text-primary-600 hover:text-primary-700 text-sm">
              ← Volver a mis anuncios
            </a>
            <h1 class="mt-2 text-2xl font-bold text-gray-900">Editar Anuncio</h1>
          </div>

          <form id="edit-ad-form" class="bg-white rounded-xl border border-gray-200 p-6">
            <div class="space-y-6">
              <div>
                <label for="title" class="block text-sm font-medium text-gray-700 mb-1">
                  Título del anuncio *
                </label>
                <input
                  type="text"
                  id="title"
                  name="title"
                  required
                  value="${ad.title}"
                  class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-transparent"
                  placeholder="Ej: Desarrollo de aplicación web para e-commerce"
                />
              </div>

              <div>
                <label for="categoryId" class="block text-sm font-medium text-gray-700 mb-1">
                  Categoría *
                </label>
                <select
                  id="categoryId"
                  name="categoryId"
                  required
                  class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-transparent"
                >
                  <option value="">Selecciona una categoría</option>
                  ${categories.map((cat: any) => `
                    <option value="${cat.id}" ${cat.id === ad.categoryId ? 'selected' : ''}>
                      ${cat.name}
                    </option>
                  `).join('')}
                </select>
              </div>

              <div>
                <label for="description" class="block text-sm font-medium text-gray-700 mb-1">
                  Descripción detallada *
                </label>
                <textarea
                  id="description"
                  name="description"
                  required
                  rows="6"
                  class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-transparent"
                  placeholder="Describe con detalle lo que necesitas, requisitos técnicos, objetivos..."
                >${ad.description}</textarea>
              </div>

              <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                  <label for="budgetMin" class="block text-sm font-medium text-gray-700 mb-1">
                    Presupuesto mínimo (€)
                  </label>
                  <input
                    type="number"
                    id="budgetMin"
                    name="budgetMin"
                    min="0"
                    step="0.01"
                    value="${ad.budgetMin || ''}"
                    class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-transparent"
                    placeholder="0.00"
                  />
                </div>
                <div>
                  <label for="budgetMax" class="block text-sm font-medium text-gray-700 mb-1">
                    Presupuesto máximo (€)
                  </label>
                  <input
                    type="number"
                    id="budgetMax"
                    name="budgetMax"
                    min="0"
                    step="0.01"
                    value="${ad.budgetMax || ''}"
                    class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-transparent"
                    placeholder="0.00"
                  />
                </div>
              </div>

              <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                  <label for="modality" class="block text-sm font-medium text-gray-700 mb-1">
                    Modalidad *
                  </label>
                  <select
                    id="modality"
                    name="modality"
                    required
                    class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-transparent"
                  >
                    <option value="online" ${ad.modality === 'online' ? 'selected' : ''}>Online / Remoto</option>
                    <option value="presencial" ${ad.modality === 'presencial' ? 'selected' : ''}>Presencial</option>
                    <option value="hibrido" ${ad.modality === 'hibrido' ? 'selected' : ''}>Híbrido</option>
                  </select>
                </div>
                <div>
                  <label for="location" class="block text-sm font-medium text-gray-700 mb-1">
                    Ubicación
                  </label>
                  <input
                    type="text"
                    id="location"
                    name="location"
                    value="${ad.location || ''}"
                    class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-transparent"
                    placeholder="Ej: Madrid, Barcelona, Remoto..."
                  />
                </div>
              </div>

              <div>
                <label for="status" class="block text-sm font-medium text-gray-700 mb-1">
                  Estado
                </label>
                <select
                  id="status"
                  name="status"
                  class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-transparent"
                >
                  <option value="draft" ${ad.status === 'draft' ? 'selected' : ''}>Borrador</option>
                  <option value="active" ${ad.status === 'active' ? 'selected' : ''}>Activo</option>
                  <option value="closed" ${ad.status === 'closed' ? 'selected' : ''}>Cerrado</option>
                </select>
              </div>
            </div>

            <div class="mt-8 flex flex-col sm:flex-row gap-4">
              <button
                type="submit"
                class="flex-1 px-6 py-3 bg-primary-600 text-white font-medium rounded-lg hover:bg-primary-700 transition-colors"
              >
                Guardar cambios
              </button>
              <button
                type="button"
                id="delete-ad"
                class="px-6 py-3 border border-red-300 text-red-600 font-medium rounded-lg hover:bg-red-50 transition-colors"
              >
                Eliminar anuncio
              </button>
            </div>

            <p id="form-message" class="mt-4 text-sm hidden"></p>
          </form>
        </div>
      `;

      // Form submission
      document.getElementById('edit-ad-form')?.addEventListener('submit', async (e) => {
        e.preventDefault();

        const form = e.target as HTMLFormElement;
        const formData = new FormData(form);
        const messageEl = document.getElementById('form-message')!;

        const data: any = {
          title: formData.get('title'),
          categoryId: parseInt(formData.get('categoryId') as string),
          description: formData.get('description'),
          modality: formData.get('modality'),
          status: formData.get('status'),
        };

        const budgetMin = formData.get('budgetMin');
        const budgetMax = formData.get('budgetMax');
        const location = formData.get('location');

        if (budgetMin) data.budgetMin = parseFloat(budgetMin as string);
        if (budgetMax) data.budgetMax = parseFloat(budgetMax as string);
        if (location) data.location = location;

        try {
          const response = await adApi.update(adId!, data);

          if (response.success) {
            messageEl.textContent = 'Anuncio actualizado correctamente';
            messageEl.className = 'mt-4 text-sm text-green-600';
            messageEl.classList.remove('hidden');

            setTimeout(() => {
              window.location.href = '/dashboard/cliente/anuncios';
            }, 1500);
          } else {
            throw new Error(response.error || 'Error al actualizar');
          }
        } catch (error: any) {
          messageEl.textContent = error.message || 'Error al actualizar el anuncio';
          messageEl.className = 'mt-4 text-sm text-red-600';
          messageEl.classList.remove('hidden');
        }
      });

      // Delete ad
      document.getElementById('delete-ad')?.addEventListener('click', async () => {
        if (confirm('¿Estás seguro de que quieres eliminar este anuncio? Esta acción no se puede deshacer.')) {
          try {
            const response = await adApi.delete(adId!);

            if (response.success) {
              window.location.href = '/dashboard/cliente/anuncios';
            } else {
              throw new Error(response.error || 'Error al eliminar');
            }
          } catch (error: any) {
            const messageEl = document.getElementById('form-message')!;
            messageEl.textContent = error.message || 'Error al eliminar el anuncio';
            messageEl.className = 'mt-4 text-sm text-red-600';
            messageEl.classList.remove('hidden');
          }
        }
      });
    } catch (error) {
      container!.innerHTML = `
        <div class="text-center py-12">
          <p class="text-gray-600">Error al cargar el anuncio</p>
          <a href="/dashboard/cliente/anuncios" class="mt-4 inline-block text-primary-600 hover:text-primary-700">
            Volver a mis anuncios
          </a>
        </div>
      `;
    }
  }

  loadAdForm();
</script>
