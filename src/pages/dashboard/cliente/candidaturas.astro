---
import DashboardLayout from '../../../layouts/DashboardLayout.astro';
---

<DashboardLayout title="Candidaturas Recibidas">
  <div id="received-applications-content"></div>
</DashboardLayout>

<script>
  import { applicationApi, orderApi, conversationApi, getApiUrl } from '../../../lib/api';
  import { formatDate, formatCurrency, formatRelativeTime } from '../../../lib/utils';

  const container = document.getElementById('received-applications-content');
  const urlParams = new URLSearchParams(window.location.search);
  let filterAdId = urlParams.get('adId') || '';
  let currentStatus = '';
  let currentPage = 1;
  const pageSize = 10;

  function escapeHtml(value: unknown) {
    return String(value ?? '')
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#039;');
  }

  function formatFileSize(size: number) {
    if (!size) return '';
    if (size < 1024 * 1024) return `${Math.round(size / 1024)} KB`;
    return `${(size / 1024 / 1024).toFixed(1)} MB`;
  }

  function getAttachmentUrl(url: string) {
    if (/^https?:\/\//.test(url)) return url;
    return `${getApiUrl().replace(/\/api$/, '')}${url}`;
  }

  function attachmentsHtml(attachments: any[] = []) {
    if (!attachments.length) return '';

    return `
      <div class="mt-3 rounded-lg border border-gray-200 bg-gray-50 p-3">
        <p class="mb-2 text-xs font-medium uppercase tracking-wide text-gray-500">Archivos adjuntos</p>
        <div class="flex flex-wrap gap-2">
          ${attachments.map((attachment) => `
            <a href="${escapeHtml(getAttachmentUrl(attachment.url))}" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 rounded-md bg-white px-3 py-2 text-sm text-gray-700 ring-1 ring-gray-200 hover:ring-primary-300">
              <svg class="h-4 w-4 text-primary-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.172 7l-6.586 6.586a2 2 0 102.828 2.828l6.586-6.586a4 4 0 00-5.657-5.657l-6.586 6.586a6 6 0 108.486 8.486L20.5 13" />
              </svg>
              <span>${escapeHtml(attachment.originalName)}</span>
              <span class="text-xs text-gray-400">${formatFileSize(attachment.size)}</span>
            </a>
          `).join('')}
        </div>
      </div>
    `;
  }

  async function openApplicationConversation(applicationId: string) {
    try {
      const response = await conversationApi.getForApplication(applicationId);
      if (response.success && response.data) {
        window.location.href = `/dashboard/mensajes?conversationId=${response.data.id}`;
        return;
      }

      alert('No se pudo abrir la conversación de esta candidatura');
    } catch (error) {
      alert('Error al iniciar la conversación');
    }
  }

  async function createOrderForApplication(applicationId: string, suggestedPrice?: string) {
    let agreedPrice = suggestedPrice ? parseFloat(suggestedPrice) : NaN;
    if (!Number.isFinite(agreedPrice) || agreedPrice < 0) {
      const input = prompt('Introduce el precio acordado para la orden');
      agreedPrice = input ? parseFloat(input) : NaN;
    }

    if (!Number.isFinite(agreedPrice) || agreedPrice < 0) {
      alert('Debes indicar un precio acordado válido');
      return false;
    }

    await orderApi.create({
      applicationId: parseInt(applicationId),
      agreedPrice,
    });

    return true;
  }

  async function loadApplications() {
    try {
      const params = new URLSearchParams();
      params.set('page', currentPage.toString());
      params.set('pageSize', pageSize.toString());
      if (currentStatus) params.set('status', currentStatus);
      if (filterAdId) params.set('adId', filterAdId);

      const response = await applicationApi.getReceived(params);
      if (!response.success) throw new Error('Error');

      const { items: applications, total, totalPages } = response.data;

      const statusColors: Record<string, string> = {
        pending: 'bg-yellow-100 text-yellow-700',
        accepted: 'bg-green-100 text-green-700',
        rejected: 'bg-red-100 text-red-700',
        cancelled: 'bg-gray-100 text-gray-700',
      };

      const statusLabels: Record<string, string> = {
        pending: 'Pendiente',
        accepted: 'Aceptada',
        rejected: 'Rechazada',
        cancelled: 'Cancelada',
      };

      container!.innerHTML = `
        <div class="mb-8">
          <h1 class="text-2xl font-bold text-gray-900">Candidaturas Recibidas</h1>
          <p class="mt-1 text-gray-600">${total} candidaturas en total</p>
        </div>

        <div class="mb-6 flex flex-col sm:flex-row gap-4">
          <select id="status-filter" class="px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-transparent">
            <option value="">Todos los estados</option>
            <option value="pending" ${currentStatus === 'pending' ? 'selected' : ''}>Pendiente</option>
            <option value="accepted" ${currentStatus === 'accepted' ? 'selected' : ''}>Aceptada</option>
            <option value="rejected" ${currentStatus === 'rejected' ? 'selected' : ''}>Rechazada</option>
          </select>
          ${filterAdId ? `
            <button id="clear-ad-filter" class="px-4 py-2 text-sm text-gray-600 border border-gray-300 rounded-lg hover:bg-gray-50">
              Limpiar filtro de anuncio
            </button>
          ` : ''}
        </div>

        ${applications.length === 0 ? `
          <div class="text-center py-12 bg-white rounded-xl border border-gray-200">
            <svg class="h-12 w-12 mx-auto text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
            </svg>
            <p class="mt-4 text-gray-600">No has recibido candidaturas${currentStatus ? ` con estado "${statusLabels[currentStatus]}"` : ''}</p>
          </div>
        ` : `
          <div class="space-y-4">
            ${applications.map((app: any) => `
              <div class="bg-white rounded-xl border border-gray-200 overflow-hidden">
                <div class="p-6">
                  <div class="flex flex-col lg:flex-row lg:items-start gap-4">
                    <div class="flex items-center gap-4">
                      <div class="h-14 w-14 rounded-full bg-primary-100 flex items-center justify-center text-primary-700 font-semibold text-lg flex-shrink-0">
                        ${app.professional?.fullName?.split(' ').map((n: string) => n[0]).join('').slice(0, 2) || '??'}
                      </div>
                      <div>
                        <h3 class="font-semibold text-gray-900">${app.professional?.fullName || 'Usuario'}</h3>
                        <p class="text-sm text-gray-500">${app.professional?.city || 'Sin ubicación'}</p>
                        ${app.professional?.professionalProfile?.verified ? `
                          <span class="inline-flex items-center gap-1 text-xs text-green-600">
                            <svg class="h-3 w-3" fill="currentColor" viewBox="0 0 20 20">
                              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                            </svg>
                            Verificado
                          </span>
                        ` : ''}
                      </div>
                    </div>
                    <div class="flex-1">
                      <div class="flex items-center gap-2 mb-2">
                        <a href="/anuncios/${app.ad?.id}" class="text-sm text-primary-600 hover:text-primary-700">
                          ${app.ad?.title || 'Anuncio'}
                        </a>
                        <span class="px-2 py-0.5 text-xs font-medium rounded-full ${statusColors[app.status]}">
                          ${statusLabels[app.status]}
                        </span>
                      </div>
                      ${app.coverLetter ? `
                        <p class="text-gray-600 text-sm line-clamp-3">${app.coverLetter}</p>
                      ` : ''}
                      ${attachmentsHtml(app.attachments)}
                    </div>
                    <div class="flex flex-col items-end gap-2 flex-shrink-0">
                      ${app.proposedPrice ? `
                        <div class="text-right">
                          <p class="text-lg font-bold text-primary-600">${formatCurrency(app.proposedPrice)}</p>
                          <p class="text-xs text-gray-500">Precio propuesto</p>
                        </div>
                      ` : ''}
                      ${app.estimatedDays ? `
                        <p class="text-sm text-gray-500">${app.estimatedDays} días estimados</p>
                      ` : ''}
                      <p class="text-xs text-gray-400">${formatRelativeTime(app.createdAt)}</p>
                    </div>
                  </div>
                </div>

                ${app.status === 'pending' ? `
                  <div class="px-6 py-4 bg-gray-50 border-t border-gray-200 flex flex-wrap gap-3">
                    <button class="accept-btn px-4 py-2 bg-green-600 text-white text-sm rounded-lg hover:bg-green-700 transition-colors" data-id="${app.id}" data-price="${app.proposedPrice || app.ad?.budgetMin || ''}">
                      Aceptar y crear orden
                    </button>
                    <button class="reject-btn px-4 py-2 bg-red-100 text-red-700 text-sm rounded-lg hover:bg-red-200 transition-colors" data-id="${app.id}">
                      Rechazar
                    </button>
                    <button class="message-btn px-4 py-2 border border-gray-300 text-gray-700 text-sm rounded-lg hover:bg-gray-100 transition-colors" data-app="${app.id}">
                      Enviar mensaje
                    </button>
                    <a href="/profesionales/${app.professional?.id}" class="px-4 py-2 border border-gray-300 text-gray-700 text-sm rounded-lg hover:bg-gray-100 transition-colors">
                      Ver perfil
                    </a>
                  </div>
                ` : app.status === 'accepted' ? `
                  <div class="px-6 py-4 bg-green-50 border-t border-green-100 flex flex-wrap items-center justify-between gap-3">
                    <span class="text-sm text-green-700">${app.serviceOrder ? 'Candidatura aceptada - Orden de servicio creada' : 'Candidatura aceptada - Falta crear la orden'}</span>
                    <div class="flex flex-wrap gap-2">
                      <button class="message-btn rounded-lg border border-green-200 bg-white px-4 py-2 text-sm font-medium text-green-700 hover:bg-green-50" data-app="${app.id}">
                        Enviar mensaje
                      </button>
                      ${app.serviceOrder?.status === 'active' ? `
                        <button class="complete-order rounded-lg bg-green-600 px-4 py-2 text-sm font-medium text-white hover:bg-green-700" data-order="${app.serviceOrder.id}">
                          Completar orden
                        </button>
                      ` : ''}
                      ${!app.serviceOrder ? `
                        <button class="create-order rounded-lg bg-green-600 px-4 py-2 text-sm font-medium text-white hover:bg-green-700" data-id="${app.id}" data-price="${app.proposedPrice || app.ad?.budgetMin || ''}">
                          Crear orden
                        </button>
                      ` : `
                        <a href="/dashboard/cliente/ordenes" class="rounded-lg border border-green-200 bg-white px-4 py-2 text-sm font-medium text-green-700 hover:bg-green-50">
                          Ver orden
                        </a>
                      `}
                    </div>
                  </div>
                ` : `
                  <div class="px-6 py-4 bg-gray-50 border-t border-gray-200 flex flex-wrap gap-3">
                    <button class="message-btn px-4 py-2 border border-gray-300 text-gray-700 text-sm rounded-lg hover:bg-gray-100 transition-colors" data-app="${app.id}">
                      Enviar mensaje
                    </button>
                    <a href="/profesionales/${app.professional?.id}" class="px-4 py-2 border border-gray-300 text-gray-700 text-sm rounded-lg hover:bg-gray-100 transition-colors">
                      Ver perfil
                    </a>
                  </div>
                `}
              </div>
            `).join('')}
          </div>

          ${totalPages > 1 ? `
            <div class="mt-8 flex justify-center gap-2">
              <button id="prev-page" class="px-4 py-2 border border-gray-300 rounded-lg hover:bg-gray-50 disabled:opacity-50 disabled:cursor-not-allowed" ${currentPage === 1 ? 'disabled' : ''}>
                Anterior
              </button>
              <span class="px-4 py-2 text-gray-600">
                Página ${currentPage} de ${totalPages}
              </span>
              <button id="next-page" class="px-4 py-2 border border-gray-300 rounded-lg hover:bg-gray-50 disabled:opacity-50 disabled:cursor-not-allowed" ${currentPage === totalPages ? 'disabled' : ''}>
                Siguiente
              </button>
            </div>
          ` : ''}
        `}
      `;

      // Event handlers
      document.getElementById('status-filter')?.addEventListener('change', (e) => {
        currentStatus = (e.target as HTMLSelectElement).value;
        currentPage = 1;
        loadApplications();
      });

      document.getElementById('clear-ad-filter')?.addEventListener('click', () => {
        filterAdId = '';
        window.history.replaceState({}, '', '/dashboard/cliente/candidaturas');
        loadApplications();
      });

      document.getElementById('prev-page')?.addEventListener('click', () => {
        if (currentPage > 1) {
          currentPage--;
          loadApplications();
        }
      });

      document.getElementById('next-page')?.addEventListener('click', () => {
        if (currentPage < totalPages) {
          currentPage++;
          loadApplications();
        }
      });

      // Accept application
      document.querySelectorAll('.accept-btn').forEach((btn) => {
        btn.addEventListener('click', async () => {
          const id = (btn as HTMLElement).dataset.id;
          const suggestedPrice = (btn as HTMLElement).dataset.price;

          if (id && confirm('¿Aceptar esta candidatura y crear una orden de servicio?')) {
            try {
              // Update application status
              await applicationApi.updateStatus(id, 'accepted');

              // Create order
              const created = await createOrderForApplication(id, suggestedPrice);
              if (!created) return;

              loadApplications();
            } catch (error) {
              alert('Error al aceptar la candidatura');
            }
          }
        });
      });

      // Reject application
      document.querySelectorAll('.reject-btn').forEach((btn) => {
        btn.addEventListener('click', async () => {
          const id = (btn as HTMLElement).dataset.id;
          if (id && confirm('¿Rechazar esta candidatura?')) {
            try {
              await applicationApi.updateStatus(id, 'rejected');
              loadApplications();
            } catch (error) {
              alert('Error al rechazar la candidatura');
            }
          }
        });
      });

      // Create missing order for an already accepted application
      document.querySelectorAll('.create-order').forEach((btn) => {
        btn.addEventListener('click', async () => {
          const id = (btn as HTMLElement).dataset.id;
          const suggestedPrice = (btn as HTMLElement).dataset.price;
          if (id && confirm('¿Crear la orden de servicio para esta candidatura?')) {
            try {
              const created = await createOrderForApplication(id, suggestedPrice);
              if (created) {
                loadApplications();
              }
            } catch (error) {
              alert('Error al crear la orden');
            }
          }
        });
      });

      // Message professional
      document.querySelectorAll('.message-btn').forEach((btn) => {
        btn.addEventListener('click', async () => {
          const applicationId = (btn as HTMLElement).dataset.app;
          if (applicationId) {
            await openApplicationConversation(applicationId);
          }
        });
      });

      // Complete order from accepted application
      document.querySelectorAll('.complete-order').forEach((btn) => {
        btn.addEventListener('click', async () => {
          const orderId = (btn as HTMLElement).dataset.order;
          if (orderId && confirm('¿Marcar esta orden como completada?')) {
            try {
              await orderApi.updateStatus(orderId, 'completed');
              loadApplications();
            } catch (error) {
              alert('Error al completar la orden');
            }
          }
        });
      });
    } catch (error) {
      container!.innerHTML = `
        <div class="text-center py-12">
          <p class="text-gray-600">Error al cargar las candidaturas</p>
          <button onclick="location.reload()" class="mt-4 text-primary-600 hover:text-primary-700">
            Reintentar
          </button>
        </div>
      `;
    }
  }

  loadApplications();
</script>
